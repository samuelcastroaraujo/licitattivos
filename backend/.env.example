SUPABASE_URL=
SUPABASE_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
APIFY_TOKEN=
APIFY_ACTOR_ID=
APIFY_TASK_ID=
APIFY_WEBHOOK_SECRET=
# UFs separadas por vírgula. Vazio desliga a busca automática diária.
INGEST_UFS=GO,SP,MG,RN,PR,SC
INGEST_HORA=6
FRONTEND_URL=
ENVIRONMENT=production
# Gere um valor longo e aleatório. O mesmo valor vai no painel (frontend).
API_TOKEN=

# IA da extração de itens: "gemini" ou "openrouter"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Principal primeiro; os outros entram se o Google estiver sobrecarregado
GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash,gemini-3.7-flash
